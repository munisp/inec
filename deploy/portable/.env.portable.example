# Hybrid portable Docker-host release configuration.
# Copy to a protected file outside the repository, set chmod 600, and never commit it.
# This mode avoids Kasicloud: it pulls verified GHCR frontend/backend images and
# builds the campaign dashboard plus Caddy edge from a checked-out source revision.

# Public DNS names. Point both A/AAAA records at the selected Docker host before launch.
INEC_PUBLIC_HOST=inec.example.ng
CAMPAIGN_PUBLIC_HOST=campaign.example.ng
CORS_ORIGINS=https://inec.example.ng,https://campaign.example.ng
ALLOWED_ORIGINS=https://inec.example.ng,https://campaign.example.ng

# Verified immutable artifacts published by the successful GitHub-hosted CD run.
# Retain digest references; never substitute :latest.
INEC_FRONTEND_IMAGE=ghcr.io/munisp/inec-frontend:sha-0349777@sha256:a1867e32f27a43fcebca7f5e06d02dff67c638a95e1d9dd43d92f90cd99d9931
INEC_BACKEND_IMAGE=ghcr.io/munisp/inec-backend:sha-0349777@sha256:52ab755d52591c43345f8cc7ebefec9291102bebec5cfc0aec9c0e26a1c9430d

# Set this to the exact checked-out commit that supplies caddy/ and campaign-platform/.
# The guarded script confirms that the working tree matches it before building.
PORTABLE_SOURCE_SHA=REPLACE_WITH_CHECKED_OUT_COMMIT

# Reuse the reviewed production values from .env.production.example.
APP_ENV=production
PG_DB=
PG_USER=
PG_PASSWORD=
REPLICATOR_PASSWORD=
PGPOOL_ADMIN_USER=
PGPOOL_ADMIN_PASSWORD=
JWT_SECRET=
HSM_MASTER_KEY=
VAULT_KEY=
APISIX_ADMIN_KEY=
TALLY_DECRYPT_TOKEN=
OPENAPPSEC_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
INEC_ADMIN_PASSWORD=
OFFICER_PASSWORD=
OBSERVER_PASSWORD=
APPSEC_VERSION=
INTEGRITY_SIGNING_REQUIRED=true
INTEGRITY_SERVICE_TOKEN=
INTEGRITY_SIGNING_KEY=
INTEGRITY_VERIFYING_KEY=
INTEGRITY_SIGNER_KEY_ID=
INEC_CVR_URL=https://cvr.inecnigeria.org/
INFERENCE_ENGINE_URL=http://inference-engine:8091
RUST_INFERENCE_URL=http://inference-engine:8091
BIOMETRIC_LIVENESS_URL=http://inference-engine:8091/liveness/predict
DOCUMENT_AI_URL=http://document-ai:8089
SATELLITE_SERVICE_URL=http://satellite-change-detection:8204
STAC_API_URL=
STAC_COLLECTION=
STAC_PREVIEW_ASSET=
STAC_MAX_CLOUD_COVER=
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
MIN_TRAINING_SAMPLES=
RESOURCE_BALLOT_BUFFER=
RESOURCE_VOTERS_PER_CLERK=
RESOURCE_MIN_POLL_CLERKS=
RESOURCE_MIN_SECURITY_PERSONNEL=

# Campaign dashboard optional authentication integration. JWT_SECRET is required.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_APP_ID=

# Retain fail-closed production defaults for unapproved integrations.
FABRIC_ANCHORING_ENABLED=false
FABRIC_ANCHORING_REQUIRED=false
OPERATIONAL_SETTLEMENTS_ENABLED=false
MOJALOOP_OPERATIONAL_SETTLEMENT_ENABLED=false
BVAS_DEVICE_GATEWAY_REQUIRED=true
DEVICE_GATEWAY_SNI=
DEVICE_GATEWAY_TLS_CERT_FILE=/run/secrets/device_gateway_server.crt
DEVICE_GATEWAY_TLS_KEY_FILE=/run/secrets/device_gateway_server.key
DEVICE_GATEWAY_CLIENT_CA_FILE=/run/secrets/device_gateway_client_ca.crt
DEVICE_GATEWAY_APISIX_SSL_ID=9101
IREV_BASE_URL=
IREV_CLIENT_ID=
IREV_CLIENT_SECRET=
IREV_CLIENT_CERT_FILE=
IREV_CLIENT_KEY_FILE=
IREV_CA_FILE=
IREV_WEBHOOK_SIGNING_SECRET=
IREV_INTERFACE_VERSION=
