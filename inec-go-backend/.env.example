# INEC Go backend — environment variable reference.
# Copy to .env and fill in values for your environment.
#
# Variables marked REQUIRED-IN-PROD cause a fatal startup error (or a
# fail-closed code path) when missing/invalid with APP_ENV=production.
#
# Auto-generated from os.Getenv/config-helper usage across inec-go-backend.

# ── Core runtime ──
# deployment environment (development|staging|production) — drives fail-closed security checks
APP_ENV=
# monolith environment; set to "development" explicitly to allow ephemeral dev JWT keys
INEC_ENV=
# HTTP listen port for the monolith (default 8088)
PORT=
# gRPC listen port
GRPC_PORT=
# zerolog level (debug|info|warn|error)
LOG_LEVEL=
# log output format (json|console)
LOG_FORMAT=
# REQUIRED-IN-PROD: PostgreSQL DSN (postgres://user:pass@host:5432/db)
DATABASE_URL=
# optional read-replica DSN for read scaling
DATABASE_REPLICA_URL=
# REQUIRED-IN-PROD: HS256 JWT signing secret, >=32 chars (fatal otherwise)
JWT_SECRET=
# REQUIRED-IN-PROD: comma-separated allowed web origins; empty = deny all (fatal in production)
CORS_ORIGINS=
# WebSocket origin allow-list (falls back to CORS_ORIGINS)
ALLOWED_ORIGINS=
# REQUIRED-IN-PROD: shared secret for X-Internal-Token inter-service trust headers (gateway <-> gotv-svc)
INTERNAL_SERVICE_SECRET=
# REQUIRED-IN-PROD: comma-separated proxy CIDRs whose X-Forwarded-For/X-Real-IP headers are trusted
TRUSTED_PROXY_CIDRS=
# REQUIRED-IN-PROD: /metrics requires Authorization: Bearer <token> (fatal in production if unset; dev may stay open with a warning)
METRICS_BEARER_TOKEN=

# ── Rate limiting ──
# dashboard metrics endpoints max requests per minute per IP
RATE_LIMIT_DASHBOARD_METRICS=
# export endpoints max requests per minute per IP
RATE_LIMIT_EXPORT=
# forgot-password max attempts per minute per IP
RATE_LIMIT_FORGOT_PASSWORD=
# geo report endpoints max requests per minute per IP
RATE_LIMIT_GEO_REPORTS=
# geo tile endpoints max requests per minute per IP
RATE_LIMIT_GEO_TILES=
# POST /auth/login max attempts per minute per IP
RATE_LIMIT_LOGIN=
# POST /auth/refresh max attempts per minute per IP
RATE_LIMIT_REFRESH=
# POST /auth/register max attempts per minute per IP
RATE_LIMIT_REGISTER=
# result submission max requests per minute per IP
RATE_LIMIT_RESULTS=
# global rate limit requests per second per IP (default 100)
RATE_LIMIT_RPS=
# SMS OTP send max requests per minute per IP
RATE_LIMIT_SMS_OTP_SEND=
# SMS OTP verify max requests per minute per IP
RATE_LIMIT_SMS_OTP_VERIFY=
# global rate limit window in seconds (default 60)
RATE_LIMIT_WINDOW=

# ── Database pooling ──
# max open DB connections
DB_MAX_OPEN_CONNS=
# max idle DB connections
DB_MAX_IDLE_CONNS=
# max open connections to read replica
DB_REPLICA_MAX_OPEN_CONNS=
# max idle connections to read replica
DB_REPLICA_MAX_IDLE_CONNS=
# enable PgBouncer-aware pooling (true|false)
PGBOUNCER_ENABLED=
# enable pgpool-II integration (true|false)
PGPOOL_ENABLED=
# pgpool-II host
PGPOOL_HOST=
# pgpool-II port
PGPOOL_PORT=
# pgpool PCP admin host
PGPOOL_PCP_HOST=
# pgpool PCP admin port
PGPOOL_PCP_PORT=
# log queries slower than this (ms)
SLOW_QUERY_THRESHOLD_MS=

# ── TLS / mTLS ──
# REQUIRED-IN-PROD: TLS certificate file for HTTPS serving
TLS_CERT_FILE=
# REQUIRED-IN-PROD: TLS private key file for HTTPS serving
TLS_KEY_FILE=
# enable certificate pinning for outbound calls (true|false)
CERT_PINNING=
# SNI override for BVAS device gateway TLS
DEVICE_GATEWAY_SNI=

# ── Auth / OIDC ──
# auth-svc base URL (used by other services for JWT validation)
AUTH_SERVICE_URL=
# gateway route target for auth-svc (distributed mode)
AUTH_URL=
# Keycloak base URL for OIDC
KEYCLOAK_URL=
# Keycloak realm
KEYCLOAK_REALM=
# Keycloak OIDC client id
KEYCLOAK_CLIENT_ID=
# Keycloak OIDC client secret
KEYCLOAK_CLIENT_SECRET=
# OIDC redirect URI
OIDC_REDIRECT_URI=

# ── Inter-service URLs ──
# gateway route target for election-svc
ELECTION_URL=
# gateway route target for geo-svc
GEO_URL=
# gateway route target for bvas-svc
BVAS_URL=
# gateway route target for compliance-svc
COMPLIANCE_URL=
# gateway route target for ingestion-svc
INGESTION_URL=
# gateway route target for biometric-svc
BIOMETRIC_URL=
# biometric-svc base URL
BIOMETRIC_SERVICE_URL=
# biometric processing pipeline URL
BIOMETRIC_PIPELINE_URL=
# gateway route target for Rust inference engine
INFERENCE_URL=
# Rust ML inference engine URL (required by biometric-svc)
INFERENCE_ENGINE_URL=
# Rust inference engine URL (alias)
RUST_INFERENCE_URL=
# Fluvio streaming endpoint
FLUVIO_URL=
# gateway route target for Fluvio stream service
FLUVIO_STREAM_URL=
# Python lakehouse analytics URL
LAKEHOUSE_URL=
# Python document AI service URL
DOCUMENT_AI_URL=
# campaign planning service URL
CAMPAIGN_PLANNING_URL=
# email delivery service URL
EMAIL_SERVICE_URL=
# SMS gateway service URL
SMS_GATEWAY_URL=
# webhook dispatcher service URL
WEBHOOK_DISPATCH_URL=
# AI assistant service URL
AI_SERVICE_URL=
# AI provider API URL
AI_API_URL=
# AI provider API key
AI_API_KEY=
# AI model identifier
AI_MODEL_ID=

# ── GOTV ──
# REQUIRED-IN-PROD (gotv deployments): Python GOTV analytics URL
GOTV_ANALYTICS_URL=
# GOTV blockchain anchoring service URL
GOTV_ANCHOR_SERVICE_URL=
# GOTV biometric verification service URL
GOTV_BIOMETRIC_SERVICE_URL=
# GOTV-specific CORS origin allow-list
GOTV_CORS_ORIGINS=
# GOTV dev mode (relaxed auth) — never true in production
GOTV_DEV_MODE=
# GOTV election crypto backend URL
GOTV_ELECTION_CRYPTO_BACKEND_URL=
# REQUIRED-IN-PROD (gotv deployments): AES-256 field-encryption key (64 hex chars)
GOTV_ENCRYPTION_KEY=
# REQUIRED-IN-PROD (gotv deployments): Rust GOTV geo-matching engine URL
GOTV_ENGINE_URL=
# GOTV outbound email From address
GOTV_FROM_EMAIL=
# legacy alias of INTERNAL_SERVICE_SECRET for gateway trust headers
GOTV_GATEWAY_SECRET=
# GOTV media storage directory
GOTV_MEDIA_DIR=
# REQUIRED-IN-PROD (gotv deployments): hex-encoded >=32-byte mobile JWT secret (fatal in production otherwise)
GOTV_MOBILE_JWT_SECRET=
# GOTV test database DSN
GOTV_TEST_DB=
# REQUIRED-IN-PROD (gotv deployments): gateway route target for gotv-svc
GOTV_URL=

# ── Crypto / HSM ──
# master key when using software HSM fallback
HSM_MASTER_KEY=
# cloud KMS provider for HSM (aws|gcp|azure)
HSM_CLOUD_KMS=
# PKCS#11 library path
HSM_PKCS11_LIB=
# PKCS#11 token PIN
HSM_PKCS11_PIN=
# PKCS#11 token label
HSM_PKCS11_TOKEN_LABEL=
# PKCS#11 key label
HSM_PKCS11_KEY_LABEL=
# biometric vault encryption key (required by biometric-svc)
VAULT_KEY=
# biometric template encryption master key
BIOMETRIC_MASTER_KEY=
# biometric vault master key
BIOMETRIC_VAULT_MASTER_KEY=
# enable at-rest field encryption (true|false)
DB_ENCRYPTION=

# ── Blockchain / Fabric anchoring ──
# blockchain RPC endpoint
BLOCKCHAIN_RPC_URL=
# pledge smart contract address
PLEDGE_CONTRACT_ADDR=
# enable Hyperledger Fabric result anchoring (true|false)
FABRIC_ANCHORING_ENABLED=
# treat Fabric anchoring failure as fatal (true|false)
FABRIC_ANCHORING_REQUIRED=
# seconds between Fabric anchoring retries
FABRIC_ANCHOR_RETRY_SECONDS=
# Fabric chaincode name
FABRIC_CHAINCODE=
# Fabric channel name
FABRIC_CHANNEL=
# Fabric client mTLS certificate
FABRIC_CLIENT_CERT_FILE=
# Fabric client mTLS key
FABRIC_CLIENT_KEY_FILE=
# Fabric contract name
FABRIC_CONTRACT=
# comma-separated Fabric endorsing MSP ids
FABRIC_ENDORSING_MSPS=
# Fabric gateway endpoint
FABRIC_GATEWAY_ENDPOINT=
# Fabric MSP id
FABRIC_MSP_ID=
# Fabric TLS root CA certificate
FABRIC_TLS_ROOT_CERT_FILE=
# Fabric TLS server name override
FABRIC_TLS_SERVER_NAME=

# ── IReV integration ──
# IReV API base URL
IREV_API_BASE_URL=
# IReV CA certificate for mTLS
IREV_CA_CERT_FILE=
# IReV mTLS client certificate
IREV_MTLS_CLIENT_CERT_FILE=
# IReV mTLS client key
IREV_MTLS_CLIENT_KEY_FILE=
# IReV OAuth audience
IREV_OAUTH_AUDIENCE=
# IReV OAuth client id
IREV_OAUTH_CLIENT_ID=
# IReV OAuth client secret
IREV_OAUTH_CLIENT_SECRET=
# IReV OAuth scope
IREV_OAUTH_SCOPE=
# IReV OAuth token URL
IREV_OAUTH_TOKEN_URL=
# treat IReV submission failure as fatal (true|false)
IREV_REQUIRED=
# IReV submission API path
IREV_SUBMIT_PATH=
# IReV webhook HMAC secret
IREV_WEBHOOK_HMAC_SECRET=

# ── Mojaloop settlement ──
# Mojaloop CA certificate
MOJALOOP_CA_FILE=
# Mojaloop operational payer FSP id
MOJALOOP_OPERATIONAL_PAYER_FSP=
# Mojaloop TLS client certificate
MOJALOOP_TLS_CERT_FILE=
# Mojaloop TLS client key
MOJALOOP_TLS_KEY_FILE=
# Mojaloop switch URL
MOJALOOP_URL=

# ── Middleware infrastructure ──
# Redis URL (redis://...)
REDIS_URL=
# Redis host:port
REDIS_ADDR=
# Redis password
REDIS_PASSWORD=
# comma-separated Redis cluster addresses
REDIS_CLUSTER_ADDRS=
# comma-separated Kafka brokers
KAFKA_BROKERS=
# TigerBeetle ledger URL
TIGERBEETLE_URL=
# comma-separated TigerBeetle replica addresses
TIGERBEETLE_ADDRESSES=
# Temporal server URL
TEMPORAL_URL=
# Temporal frontend URL
TEMPORAL_FRONTEND_URL=
# Temporal host:port
TEMPORAL_HOSTPORT=
# Temporal namespace
TEMPORAL_NAMESPACE=
# Dapr sidecar HTTP port
DAPR_HTTP_PORT=
# Dapr sidecar HTTP URL
DAPR_HTTP_URL=
# APISIX admin API URL
APISIX_ADMIN_URL=
# APISIX admin API key
APISIX_API_KEY=
# Caddy admin API URL
CADDY_ADMIN_URL=
# Permify authorization service URL
PERMIFY_URL=
# Permify tenant id
PERMIFY_TENANT_ID=
# OpenAppSec agent URL
OPENAPPSEC_URL=
# true when WAF enforcement is attached at APISIX gateway (required in production)
OPENAPPSEC_GATEWAY_ENFORCED=
# OpenSearch URL
OPENSEARCH_URL=
# OpenSearch username
OPENSEARCH_USERNAME=
# OpenSearch password
OPENSEARCH_PASSWORD=
# OSRM routing service URL
OSRM_URL=
# OpenTelemetry OTLP exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
# OpenTelemetry service name
OTEL_SERVICE_NAME=

# ── SMS / email providers ──
# SMS provider selector (africastalking|twilio|...)
SMS_PROVIDER=
# SMS sender shortcode
SMS_SHORTCODE=
# Africa's Talking API username
AFRICASTALKING_USERNAME=
# Africa's Talking API key
AFRICASTALKING_API_KEY=
# Africa's Talking sender id
AFRICASTALKING_SENDER=
# Africa's Talking username (alias)
AT_USERNAME=
# Africa's Talking API key (alias)
AT_API_KEY=
# Africa's Talking environment (sandbox|production)
AT_ENVIRONMENT=
# Africa's Talking webhook secret
AT_WEBHOOK_SECRET=
# Twilio account SID
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# Mailgun API key
MAILGUN_API_KEY=
# Mailgun domain
MAILGUN_DOMAIN=
# SendGrid API key
SENDGRID_API_KEY=
# NCC do-not-disturb registry API key
NCC_DND_API_KEY=
# NCC do-not-disturb registry URL
NCC_DND_REGISTRY_URL=

# ── Social platforms ──
# Facebook page id
FACEBOOK_PAGE_ID=
# Facebook page access token
FACEBOOK_PAGE_TOKEN=
# Instagram business account id
INSTAGRAM_ACCOUNT_ID=
# Instagram access token
INSTAGRAM_ACCESS_TOKEN=
# Twitter/X bearer token
TWITTER_BEARER_TOKEN=
# TikTok access token
TIKTOK_ACCESS_TOKEN=
# WhatsApp app secret
WHATSAPP_APP_SECRET=
# enable WhatsApp interactive messages (true|false)
WHATSAPP_INTERACTIVE=
# WhatsApp phone number id
WHATSAPP_PHONE_ID=
# WhatsApp access token
WHATSAPP_TOKEN=
# REQUIRED-IN-PROD when the WhatsApp integration is enabled (WHATSAPP_TOKEN set): webhook verification token
WHATSAPP_WEBHOOK_TOKEN=

# ── External identity verification ──
# CAC (corporate affairs) API key
CAC_API_KEY=
# CAC API URL
CAC_API_URL=
# NIBSS API key
NIBSS_API_KEY=
# NIBSS API URL
NIBSS_API_URL=
# NIMC API key
NIMC_API_KEY=
# NIMC secret key
NIMC_SECRET_KEY=
# NIMC API URL
NIMC_API_URL=

# ── Voice / AI ──
# Vapi voice phone id
VAPI_PHONE_ID=
# voice AI agent id
VOICE_AI_AGENT_ID=
# voice AI provider API key
VOICE_AI_API_KEY=
# voice AI provider API URL
VOICE_AI_API_URL=
# voice AI provider selector
VOICE_AI_PROVIDER=
# directory containing ML models
ML_MODELS_DIR=
# GNN geo-matching distance threshold (km)
GNN_DISTANCE_THRESHOLD_KM=

# ── Miscellaneous ──
# INEC CVR service URL
INEC_CVR_URL=
# OpenWeather API key
OPENWEATHER_API_KEY=
# Firebase Cloud Messaging project id
FCM_PROJECT_ID=
# Firebase Cloud Messaging server key
FCM_SERVER_KEY=
# collation cache TTL (seconds)
COLLATION_CACHE_TTL_SEC=
# ingestion queue capacity
INGESTION_QUEUE_CAPACITY=
# evidence-integrity service token
INTEGRITY_SERVICE_TOKEN=
# require evidence integrity signatures (true|false)
INTEGRITY_SIGNING_REQUIRED=
# TigerBeetle account prefix for device settlement
OPERATIONAL_SETTLEMENT_DEVICE_ACCOUNT_PREFIX=
# TigerBeetle treasury account id
OPERATIONAL_SETTLEMENT_TREASURY_ACCOUNT=

# ── Seeding / testing (never production) ──
# seeded admin password — REQUIRED whenever E2E fixture seeding runs
SEED_ADMIN_PASSWORD=
# seeded observer password — REQUIRED whenever E2E fixture seeding runs
SEED_OBSERVER_PASSWORD=
# allow E2E fixture seeding in development (1|true|yes)
INEC_E2E_SEED=
# CI flag — legacy fallback that permits E2E fixture seeding when APP_ENV is unset
GITHUB_ACTIONS=
# dbseed utility environment selector
DBSEED_ENV=
# DSN used by integration tests
TEST_DATABASE_URL=
