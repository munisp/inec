# Evidence-anchor Fabric chaincode lifecycle definition.
# This file contains no credentials. Values must be jointly approved by channel members
# before running deploy-evidence-anchor.sh on an authorized Fabric CLI host.

FABRIC_CHANNEL=inec-evidence
FABRIC_CHAINCODE=evidence-anchor
FABRIC_CHAINCODE_VERSION=1.0.0
FABRIC_CHAINCODE_SEQUENCE=1
FABRIC_CHAINCODE_LABEL=evidence-anchor_1.0.0
# A secure baseline: the peer of both the election authority and independent
# observer/audit institution must endorse every signed evidence anchor write.
FABRIC_SIGNATURE_POLICY="AND('INECMSP.peer','ObserverMSP.peer')"
