{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_GOTV_API_URL": "http://localhost:8103"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://TODO-REPLACE-WITH-REAL-STAGING-API-HOST.invalid",
        "EXPO_PUBLIC_GOTV_API_URL": "https://TODO-REPLACE-WITH-REAL-STAGING-GOTV-HOST.invalid"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://TODO-REPLACE-WITH-REAL-PRODUCTION-API-HOST.invalid",
        "EXPO_PUBLIC_GOTV_API_URL": "https://TODO-REPLACE-WITH-REAL-PRODUCTION-GOTV-HOST.invalid"
      }
    }
  }
}
