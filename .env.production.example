# INEC production environment template
#
# Copy this file to .env only on the Kasicloud deployment host, set every blank
# value from the approved secret-management process, and restrict the resulting
# file to the deployment account (chmod 600 .env). Do not commit .env.
#
# Empty values are intentional. Docker Compose uses required-variable guards for
# production secrets and will refuse to start affected services until they are set.

# Deployment identity and permitted browser origins (replace domains before launch)
CORS_ORIGINS=https://inec.example.ng,https://campaign.example.ng
ALLOWED_ORIGINS=https://inec.example.ng,https://campaign.example.ng

# PostgreSQL primary, replica, Pgpool, Keycloak, and service database identities
PG_DB=
PG_USER=
PG_PASSWORD=
REPLICATOR_PASSWORD=
PGPOOL_ADMIN_USER=
PGPOOL_ADMIN_PASSWORD=

# Platform cryptographic material and API gateway administration
JWT_SECRET=
HSM_MASTER_KEY=
VAULT_KEY=
APISIX_ADMIN_KEY=
TALLY_DECRYPT_TOKEN=
OPENAPPSEC_DB_PASSWORD=

# Keycloak bootstrap and INEC role-account credentials
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
INEC_ADMIN_PASSWORD=
OFFICER_PASSWORD=
OBSERVER_PASSWORD=

# Model governance: deploy the approved artifact and immutable manifest together.
# MODELS_DIR must contain anomaly_xgboost.onnx and anomaly_xgboost.manifest.json.
MODELS_DIR=/app/models
INFERENCE_ENGINE_URL=http://inference-engine:8091
RUST_INFERENCE_URL=http://inference-engine:8091
BIOMETRIC_LIVENESS_URL=http://inference-engine:8091/liveness/predict

# Evidence integrity signer. Generate a unique 32-byte Ed25519 signing key and
# a unique service token through the approved secret-management process.
APP_ENV=production
INTEGRITY_SIGNING_REQUIRED=true
INTEGRITY_SERVICE_TOKEN=
INTEGRITY_SIGNING_KEY=
INTEGRITY_VERIFYING_KEY=
INTEGRITY_SIGNER_KEY_ID=

# Hyperledger Fabric consortium anchoring. Do not enable these values until the
# channel, chaincode, peer Gateway, MSP identity, TLS material, and governance
# transaction have been approved by the participating institutions. Fabric stores
# only signed evidence hashes and receipts; raw EC8A artifacts remain off-chain.
FABRIC_ANCHORING_ENABLED=false
FABRIC_ANCHORING_REQUIRED=false
FABRIC_ANCHOR_RETRY_SECONDS=30
FABRIC_GATEWAY_ENDPOINT=
FABRIC_TLS_SERVER_NAME=
FABRIC_MSP_ID=
FABRIC_CHANNEL=inec-evidence
FABRIC_CHAINCODE=evidence-anchor
FABRIC_CONTRACT=
FABRIC_ENDORSING_MSPS=INECMSP,ObserverMSP
# Host path mounted read-only by docker-compose.fabric.yml; never commit these files.
FABRIC_SECRETS_DIR=
FABRIC_DOCKER_NETWORK=
FABRIC_TLS_ROOT_CERT_FILE=/run/secrets/fabric/tls-root-cert.pem
FABRIC_CLIENT_CERT_FILE=/run/secrets/fabric/client-cert.pem
FABRIC_CLIENT_KEY_FILE=/run/secrets/fabric/client-key.pem

# Document AI and authoritative identity verification providers.
# PaddleOCR and Docling run in the document-ai service. The VLM must be a
# self-hosted, approved endpoint; do not set a public provider fallback.
DOCUMENT_AI_URL=http://document-ai:8089
OCR_MODEL_DIR=/models/paddleocr
DOCLING_MODEL=docling-v2
VLM_ENDPOINT=
VLM_MODEL=
SECONDARY_OCR_ENDPOINT=
SECONDARY_OCR_ENGINE=got-ocr2.0
SECONDARY_OCR_REQUIRED=false
DOCUMENT_INTEGRITY_POLICY_VERSION=
DOCUMENT_ANALYSIS_VERSION=evidence-consensus-v1
MAX_DOCUMENT_BYTES=20000000
MIN_OCR_CONFIDENCE=0.75
MIN_VLM_COMPLETENESS=0.80
MIN_DOCUMENT_EDGE=720

# Official external voter-service navigation. This must remain an HTTPS INEC URL.
INEC_CVR_URL=https://cvr.inecnigeria.org/

NIMC_VERIFICATION_URL=
IDENTITY_VERIFICATION_URL=
SANCTIONS_SCREENING_URL=

# Satellite change detection must use an approved real STAC source.
SATELLITE_SERVICE_URL=http://satellite-change-detection:8204
STAC_API_URL=
STAC_COLLECTION=
STAC_PREVIEW_ASSET=
STAC_MAX_CLOUD_COVER=

# Campaign-planning AI. Use only an approved provider account and model.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
CAMPAIGN_PLANNING_URL=http://campaign-planning:8206
INEC_API_URL=http://go-backend:8088

# Required operational integrations
PERMIFY_URL=http://permify:3476
PERMIFY_TENANT_ID=inec
TIGERBEETLE_URL=tigerbeetle:3001
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=kafka:29092
KAFKA_REST_URL=http://kafka-rest:8082
DAPR_HTTP_PORT=3500
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
FLUVIO_ENDPOINT=fluvio-sc:9003
FLUVIO_STREAM_URL=http://fluvio-stream:8100
FLUVIO_TOPIC_AUDIT=inec.audit.log
FLUVIO_TOPIC_RESULTS=inec.results.submitted
DAPR_API_TOKEN=
DAPR_PUBSUB_NAME=pubsub
DAPR_EXTERNAL_DEVICE_TOPIC=inec.bvas.device-event.v1
LAKEHOUSE_URL=http://lakehouse:8090
SEDONA_SERVICE_TOKEN=
DEVICE_GEOFENCE_METERS=
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# P0 device gateway: the APISIX SSL resource must be provisioned from these mounted files.
BVAS_DEVICE_GATEWAY_REQUIRED=true
DEVICE_GATEWAY_SNI=
DEVICE_GATEWAY_TLS_CERT_FILE=/run/secrets/device_gateway_server.crt
DEVICE_GATEWAY_TLS_KEY_FILE=/run/secrets/device_gateway_server.key
DEVICE_GATEWAY_CLIENT_CA_FILE=/run/secrets/device_gateway_client_ca.crt
DEVICE_GATEWAY_APISIX_SSL_ID=9101
INTEGRITY_SERVICE_TOKEN=

# P1 authorized IReV integration. Do not enable until INEC supplies an approved contract.
IREV_BASE_URL=
IREV_CLIENT_ID=
IREV_CLIENT_SECRET=
IREV_CLIENT_CERT_FILE=
IREV_CLIENT_KEY_FILE=
IREV_CA_FILE=
IREV_WEBHOOK_SIGNING_SECRET=
IREV_INTERFACE_VERSION=

# P2 operational settlement controls. These cover only approved BVAS logistics,
# reimbursement, and repair commitments—not voter, PVC, biometric, ballot, or result values.
# Keep both flags false until INEC finance governance, Permify policy, TigerBeetle ledger,
# FSPIOP scheme onboarding, and mTLS acceptance testing are formally approved.
OPERATIONAL_SETTLEMENTS_ENABLED=false
OPERATIONAL_SETTLEMENT_TREASURY_ACCOUNT=
OPERATIONAL_SETTLEMENT_DEVICE_ACCOUNT_PREFIX=inec-device-operational-
OPERATIONAL_SETTLEMENT_TB_LEDGER=
OPERATIONAL_SETTLEMENT_TB_ACCOUNT_CODE=
OPERATIONAL_SETTLEMENT_TB_TRANSFER_CODE=
OPERATIONAL_SETTLEMENT_MAX_AMOUNT_MINOR=
MOJALOOP_OPERATIONAL_SETTLEMENT_ENABLED=false
MOJALOOP_URL=
MOJALOOP_OPERATIONAL_PAYER_FSP=
# Host directory mounted only by docker-compose.operational-settlement.yml.
MOJALOOP_SECRETS_DIR=
MOJALOOP_TLS_CERT_FILE=/run/secrets/mojaloop/client.crt
MOJALOOP_TLS_KEY_FILE=/run/secrets/mojaloop/client.key
MOJALOOP_CA_FILE=/run/secrets/mojaloop/ca.crt

BIOMETRIC_PIPELINE_URL=http://biometric-go:8092
BIOMETRIC_PYTHON_URL=http://biometric-python:8090
BIOMETRIC_RUST_URL=http://biometric-rust:8091

# Predictive resource-allocation model policy thresholds. These must be approved
# by the authorized electoral operations and model-governance owners.
MIN_TRAINING_SAMPLES=
RESOURCE_BALLOT_BUFFER=
RESOURCE_VOTERS_PER_CLERK=
RESOURCE_MIN_POLL_CLERKS=
RESOURCE_MIN_SECURITY_PERSONNEL=

# OpenAppSec image version must be reviewed, pinned, and recorded in deployment change control.
APPSEC_VERSION=
