# ─── Required in production (boot fails fast without them) ───────────────────
# Session JWT signing secret — at least 32 random chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# PostgreSQL connection string. POSTGRES_URL is preferred when both are set
# (DATABASE_URL may point at a platform-managed MySQL/TiDB in some hosts).
POSTGRES_URL=
DATABASE_URL=

# ─── Server (optional) ───────────────────────────────────────────────────────
# Listen port (default 3000; the Dockerfile pins 8206).
PORT=3000
# development | test | production
NODE_ENV=development

# Platform/app identity (Manus-style deployments).
VITE_APP_ID=
OWNER_OPEN_ID=

# Built-in Forge API (LLM + owner notifications + storage proxy).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Legacy OAuth (only needed if an external OAuth server is configured; the app
# authenticates via local username/password login by default).
OAUTH_SERVER_URL=

# ─── Cookie / auth behaviour (optional) ──────────────────────────────────────
# Session cookie SameSite: lax (default) | none | strict. "none" is only for
# cross-site embeds and requires HTTPS.
COOKIE_SAMESITE=
# Force the Secure attribute on/off (default: on for https requests).
COOKIE_SECURE=
# Return the session token in the /api/login JSON body for non-browser clients
# that cannot use cookies (default false).
AUTH_RETURN_SESSION_COOKIE=false

# Enable fixture seeding (seed.all) in NON-production runtimes only.
CAMPAIGN_ALLOW_FIXTURE_SEED=false

# Bearer token required to scrape GET /metrics. In production the endpoint is
# DISABLED (503, fail closed) when this is unset; outside production it stays
# open for local scraping.
METRICS_BEARER_TOKEN=

# ─── Client build-time (Vite, optional) ──────────────────────────────────────
VITE_CAMPAIGN_API_URL=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
